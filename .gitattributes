# Keep LF in the repository and working tree (PHP runs on Linux servers)
* text=auto eol=lf

*.png binary
*.jpg binary
*.zip binary

# Mail fixtures keep their CRLF line endings and 8-bit charsets byte for byte
*.eml binary

# Not included in the Composer dist archive
/.github            export-ignore
/docs               export-ignore
/tests              export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/docker-compose.yml export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
