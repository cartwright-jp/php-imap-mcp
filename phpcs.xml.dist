<?xml version="1.0"?>
<ruleset name="php-imap-mcp">
    <description>PSR-12 with declare(strict_types=1) required</description>

    <!-- Add public/ and bin/ here when they are created (M1, M2) -->
    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Every file must start with declare(strict_types=1) -->
    <rule ref="Generic.PHP.RequireStrictTypes"/>
</ruleset>
