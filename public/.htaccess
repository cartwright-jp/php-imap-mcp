# php-imap-mcp: only index.php runs in this directory (SPEC.md 4, 7).

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pass the Authorization header to PHP (XServer may drop it otherwise).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Every path goes to index.php, which routes the MCP endpoint, authorize, token and .well-known/*.
    # No other file in this directory is ever served.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Without mod_rewrite, at least nothing but index.php is served.
<IfModule !mod_rewrite.c>
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(index\.php)?$">
        Require all granted
    </FilesMatch>
</IfModule>

# IP restriction: PHP already applies auth.allowed_ips in config.php (except to the login page), so this is
# optional, for refusing requests before PHP runs. The login page (authorize) is opened by the user's browser
# from anywhere and must stay open. THE_REQUEST is the original request line (not the rewritten one):
#   <If "%{THE_REQUEST} !~ m#^[A-Z]+ [^ ?]*/authorize/?(\?[^ ]*)? #">
#       Require ip 160.79.104.0/21 153.61.208.0/20
#   </If>
