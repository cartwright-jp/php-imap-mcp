# php-imap-mcp: only index.php runs in this directory (SPEC.md 4, 7).

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pass the Authorization header to PHP (XServer may drop it otherwise).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Every path goes to index.php, which routes the MCP endpoint and, in imap_oauth mode,
    # authorize, token and .well-known/*. No other file in this directory is ever served.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Without mod_rewrite, at least nothing but index.php is served.
<IfModule !mod_rewrite.c>
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(index\.php)?$">
        Require all granted
    </FilesMatch>
</IfModule>

# IP restriction (recommended). PHP checks auth.allowed_ips as well.
#
# token mode: allow only Anthropic's published outbound ranges and your own IP:
#   Require ip 203.0.113.0/24
#
# imap_oauth mode: the login page (authorize) is opened by the user's browser from anywhere, so it must stay
# open; everything else can be restricted. THE_REQUEST is the original request line (not the rewritten one):
#   <If "%{THE_REQUEST} !~ m#^[A-Z]+ [^ ?]*/authorize/?(\?[^ ]*)? #">
#       Require ip 203.0.113.0/24
#   </If>
