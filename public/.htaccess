# php-imap-mcp: only index.php is served from this directory (SPEC.md 4, 7).

Options -Indexes
DirectoryIndex index.php

# Pass the Authorization header to PHP (XServer may drop it otherwise).
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Deny everything except index.php.
<FilesMatch ".*">
    Require all denied
</FilesMatch>
<FilesMatch "^(index\.php)?$">
    # Without IP restriction:
    Require all granted
    # With IP restriction (recommended): replace the line above with the ranges you allow, for example
    # Anthropic's published outbound ranges and your own IP. PHP checks auth.allowed_ips as well.
    # Require ip 203.0.113.0/24
    # Require ip 198.51.100.7
</FilesMatch>
